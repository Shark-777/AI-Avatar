{
  "identifier": "default",
  "description": "Default capability for all windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "shell:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-create",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-read-dir"
  ]
}
