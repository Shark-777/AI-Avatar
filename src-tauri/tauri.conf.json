{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "Buddy",
  "version": "0.1.0",
  "identifier": "com.buddy.avatar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "13.0",
      "frameworks": []
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Buddy",
        "width": 200,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "url": "index.html",
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  }
}
